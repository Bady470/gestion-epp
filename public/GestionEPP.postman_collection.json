{
  "info": {
    "name": "GestionEPP - Full API Tests",
    "_postman_id": "gestion-epp-full-tests",
    "description": "Colección de pruebas automática para la API GestionEPP: register, login (Sanctum), y tests CRUD para recursos principales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Auth & Setup",
      "item": [
        {
          "name": "Register (create test user)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_completo\":\"PM Test User\",\n  \"email\":\"pmtest@example.com\",\n  \"password\":\"secret123\",\n  \"password_confirmation\":\"secret123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/register", "host": ["{{base_url}}"], "path": ["api","register"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Register - status 201 or 200', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,201]);",
                  "});",
                  "const res = pm.response.json();",
                  "if(res && res.token){",
                  "  pm.environment.set('token', res.token);",
                  "}",
                  "if(res && res.user && res.user.id){",
                  "  pm.environment.set('usuario_id', res.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login (store token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\":\"pmtest@example.com\",\n  \"password\":\"secret123\"\n}" },
            "url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api","login"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login - status 200', function(){ pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                  "const r = pm.response.json();",
                  "const token = r.token || r.plainTextToken || r.data?.token || r.data?.plainTextToken;",
                  "pm.test('Token present', function(){ pm.expect(token).to.be.a('string'); });",
                  "pm.environment.set('token', token);",
                  "if(r.user && r.user.id) pm.environment.set('usuario_id', r.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
